# Copy to .env (gitignored). `npm run setup` writes this file for you.
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Channel the news is posted to
DISCORD_CHANNEL_ID=1572118838135234580
# optional: fine-grained GitHub token (this repo only, Actions: read & write) so the
# Cloudflare Worker can start the Instagram check every 30 min
GH_DISPATCH_TOKEN=
